# Copier ce fichier en .env puis remplacer les valeurs.
# Ne jamais committer le .env.

# PostgreSQL local. En production, utiliser l'URL du serveur.
DATABASE_URL="postgresql://postgres:mot_de_passe@localhost:5432/miahy"

# tcp : PostgreSQL local. Toute autre valeur utilise le connecteur Neon.
BD_CONNEXION=tcp

# 16 caractères minimum. Chaîne aléatoire, différente sur chaque machine.
JWT_SECRET="remplacer-par-une-chaine-secrete-longue"

# Origine du front (Vite). Doit correspondre au port réellement ouvert.
CLIENT_ORIGIN="http://localhost:3000"
PORT=4000
NODE_ENV=development

# Premier compte Direction, lu uniquement par prisma/seed.ts.
# Mot de passe d'au moins 8 caractères. Le choisir ici, ne pas le committer.
SEED_DIRECTION_EMAIL="direction@exemple.mg"
SEED_DIRECTION_MOT_DE_PASSE="changer-ce-mot-de-passe"

# Courriel des liens d'activation et de mot de passe oublié.
# Mot de passe d'application Gmail, jamais le mot de passe du compte.
GMAIL_USER="centre@gmail.com"
GMAIL_APP_PASSWORD="mot-de-passe-application"

# SMS. Laisser vide tant que le fournisseur n'est pas branché.
# SMS_FOURNISSEUR=""
# SMS_CLE=""
